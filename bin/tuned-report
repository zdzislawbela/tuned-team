#!/usr/bin/env python3
"""Report state without a message: a colleague writes its state straight into
~/bin/.tuned-zlecenia.json and the team table (tuned-agents) shows it. Nobody
has to read a message, so it costs no turns and no tokens.

  tuned-report start "~15:00" "what I'm doing"   took a task, ETA
  tuned-report eta "~16:00"                       new ETA
  tuned-report done "commit abc123"               finished

Old name: tuned-meldunek (alias).
"""
import json, os, subprocess, sys

HOME = os.path.expanduser('~')
ORDERS = f'{HOME}/bin/.tuned-zlecenia.json'


def my_session():
    """Walk up from this process to the claude whose ~/.claude/sessions/<pid>.json exists."""
    pid = os.getpid()
    while pid > 1:
        f = f'{HOME}/.claude/sessions/{pid}.json'
        if os.path.exists(f):
            return json.load(open(f)).get('name')
        pid = int(subprocess.run(['ps', '-o', 'ppid=', '-p', str(pid)], capture_output=True, text=True).stdout.strip() or 1)
    return None


def main():
    kind = {'gotowe': 'done'}.get(sys.argv[1], sys.argv[1]) if len(sys.argv) > 1 else ''
    if kind not in ('start', 'eta', 'done'):
        sys.exit(__doc__)
    name = my_session()
    if not name:
        sys.exit('Could not find my Claude session.')
    rest = sys.argv[2:]
    try:
        orders = json.load(open(ORDERS))
    except Exception:
        orders = {}
    o = orders.setdefault(name, {})
    if kind == 'start':
        o['eta'] = rest[0] if rest else '?'
        if len(rest) > 1:
            o['what'] = rest[1]
        o['done'] = False
    elif kind == 'eta':
        o['eta'] = rest[0] if rest else '?'
    else:
        o['done'] = True
        o.pop('eta', None)
        if rest:
            o['what'] = f"done: {rest[0]}"
    os.makedirs(os.path.dirname(ORDERS), exist_ok=True)
    tmp = ORDERS + '.tmp'
    json.dump(orders, open(tmp, 'w'), ensure_ascii=False, indent=1)
    os.replace(tmp, ORDERS)
    print(f"report saved ({name}): {kind} {' '.join(rest)}".strip())


main()
