#!/usr/bin/env python3
"""Team table: who waits for you, who is working (and how many background
agents it runs), who is free. Reads ~/.claude/sessions and the transcripts,
changes nothing. Shows only sessions of the repo you run it from (worktrees
included); --all shows every repo.
Usage: tuned-agents [--all] [my window name, e.g. deputy]"""
import glob, json, os, re, subprocess, sys, time

HOME = os.path.expanduser('~')
PROJECTS = f'{HOME}/.claude/projects'
ACTIVE_S = 300  # agent wrote in the last 5 min = working
# Ctx % in the table is counted against a 1M-token window (Opus); thresholds 300k / 350k.
DONE_MARK = 'READY TO CLEAR'
# Tasks I (the dispatcher session) hand out: {window: {task, at}}; newest wins over the first prompt.
ORDERS = f'{HOME}/bin/.tuned-zlecenia.json'


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except PermissionError:
        # The process exists but we may not signal it (e.g. inside the Claude Code sandbox).
        return True
    except Exception:
        return False


_repos = {}


def repo_of(cwd):
    """The repo a folder belongs to: its main checkout, the same for every worktree; None outside git."""
    if cwd not in _repos:
        try:
            out = subprocess.run(['git', '-C', cwd, 'rev-parse', '--path-format=absolute', '--git-common-dir'],
                                 capture_output=True, text=True, timeout=5).stdout.strip()
            _repos[cwd] = os.path.dirname(os.path.realpath(out)) if out else None
        except Exception:
            _repos[cwd] = None
    return _repos[cwd]


def lead_of(name):
    """'manager' / 'deputy' for both the old names and the numbered ones ('0-manager', '1-deputy')."""
    m = re.match(r'^(?:\d+-)?(manager|deputy)$', name or '')
    return m.group(1) if m else ''


def text(row):
    c = row.get('message', {}).get('content')
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return ' '.join(x.get('text', '') for x in c if isinstance(x, dict) and x.get('type') == 'text')
    return ''


def transcript(sid):
    """First real prompt, last reply text, and the tool the session waits on
    (its last message is a tool call with no result yet: a permission prompt)."""
    files = glob.glob(f'{PROJECTS}/*/{sid}.jsonl')
    if not files:
        return '', '', None, 0
    first, last, pending, ctx = '', '', None, 0
    with open(max(files, key=os.path.getmtime)) as f:
        for line in f:
            try:
                r = json.loads(line)
            except Exception:
                continue
            if r.get('type') not in ('user', 'assistant'):
                continue
            u = r.get('message', {}).get('usage')
            if r.get('type') == 'assistant' and u:
                ctx = u.get('input_tokens', 0) + u.get('cache_read_input_tokens', 0) + u.get('cache_creation_input_tokens', 0)
            if r.get('type') == 'system' and 'compact' in str(r.get('subtype', '')):
                ctx = 0
            c = r.get('message', {}).get('content')
            if r.get('type') == 'assistant' and isinstance(c, list):
                calls = [x for x in c if isinstance(x, dict) and x.get('type') == 'tool_use']
                pending = calls[-1].get('name') if calls else pending
            elif r.get('type') == 'user':
                pending = None
            t = text(r).strip()
            if not t:
                continue
            if r.get('type') == 'user' and not first and not t.startswith('<') and not t.startswith('Another Claude session'):
                first = t
            if r.get('type') == 'assistant':
                last = t
    return first, last, pending, ctx


def helpers(sid):
    """Live helpers: subagent transcripts written in the last ACTIVE_S
    seconds, split into plain subagents and workflow agents per run."""
    now = time.time()
    subs, wfs = 0, {}
    for d in glob.glob(f'{PROJECTS}/*/{sid}/subagents'):
        for p in glob.glob(f'{d}/**/*.jsonl', recursive=True):
            if now - os.path.getmtime(p) >= ACTIVE_S:
                continue
            rel = os.path.relpath(p, d).split('/')
            if rel[0] == 'workflows' and len(rel) > 2:
                wfs[rel[1]] = wfs.get(rel[1], 0) + 1
            else:
                subs += 1
    return subs, list(wfs), sum(wfs.values())


def short(s, n):
    s = ' '.join(s.split())
    return s if len(s) <= n else s[: n - 1] + '…'


def label_of(name, order):
    m = re.match(r'^(\d+)-(.+)$', name)
    if m and not (order and 'nr' in order):
        return f"#{m.group(1)} {m.group(2).replace('-', ' ')}"
    if order and 'nr' in order:
        return f"#{order['nr']} {order.get('label', '')}".strip()
    return short(name, 12)


def main():
    args = [a for a in sys.argv[1:] if a != '--all']
    me = args[0] if args else ''
    # Outside a git repo there is nothing to filter by: show everything.
    team_repo = None if '--all' in sys.argv[1:] else repo_of(os.getcwd())
    try:
        orders = json.load(open(ORDERS))
    except Exception:
        orders = {}
    rows = []
    for f in glob.glob(f'{HOME}/.claude/sessions/*.json'):
        try:
            d = json.load(open(f))
        except Exception:
            continue
        if not alive(d.get('pid', 0)):
            continue
        if team_repo and repo_of(d.get('cwd', '')) != team_repo:
            continue
        sid = d['sessionId']
        first, last, pending, ctx = transcript(sid)
        subs, wfs, wf_agents = helpers(sid)
        st = d.get('status', '?')
        if me and (d.get('name') == me or lead_of(d.get('name')) == me):
            kind = 'self'
        elif str((orders.get(d.get('name', '')) or {}).get('eta', '')).startswith('⛔'):
            kind, why = 'waiting', orders[d['name']]['eta']
        elif st == 'waiting' and not pending and not ((orders.get(d.get('name', '')) or {}).get('task') and not (orders.get(d.get('name', '')) or {}).get('done')):
            # A window waiting at its prompt with no question, no permission prompt and no open task is just free, not waiting for the owner.
            kind = 'free'
        elif st == 'waiting':
            kind = 'waiting'
            why = ('question for you' if pending == 'AskUserQuestion'
                   else f'⛔ your approval: {pending.removeprefix("mcp__")}' if pending
                   else 'your answer')
        elif st == 'busy' or subs or wfs:
            kind = 'working'
        elif DONE_MARK in last or (orders.get(d.get('name', '')) or {}).get('done') or re.match(r'^([2-9]|\d\d)-', d.get('name', '')) and not (orders.get(d.get('name', '')) or {}).get('task'):
            kind = 'free'
        else:
            kind = 'idle'
        order = orders.get(d.get('name', ''))
        topic = f"{order['task']} (given {order['at']})" if order and 'task' in order else first
        eta = (order or {}).get('eta', '')
        if kind == 'waiting':
            eta = why
        rows.append(dict(sid=sid, ctx=ctx, order=order, name=d.get('name', '?'), kind=kind, eta=eta, topic=short(topic, 70), subs=subs, wfs=wfs, wf_agents=wf_agents))

    order = {'waiting': 0, 'working': 1, 'idle': 2, 'free': 3, 'self': 4}
    rows.sort(key=lambda r: (r['order'] or {}).get('nr', int(re.match(r'^(\d+)-', r['name']).group(1)) if re.match(r'^(\d+)-', r['name']) else 99))
    n = {k: sum(1 for r in rows if r['kind'] == k) for k in order}
    agents = sum(r['subs'] + r['wf_agents'] for r in rows if r['kind'] != 'self')

    label = {'waiting': '⏳ waiting', 'working': '⚙ working', 'idle': '? no report', 'free': '✔ free', 'self': 'this session'}

    def num_of(r):
        """Slot: manager 0, deputy 1, colleague k = k + 1 (legacy windows: the order's nr)."""
        o = r['order'] or {}
        if 'nr' in o:
            return str(o['nr'])
        if lead_of(r['name']) == 'manager':
            return '0'
        if lead_of(r['name']) == 'deputy':
            return '1'
        m = re.match(r'^(\d+)-', r['name'])
        return str(int(m.group(1)) + 1) if m else ''

    def shown_nr(r):
        """Number the owner sees: colleagues count from 1; legacy windows keep their nr."""
        o = r['order'] or {}
        m = re.match(r'^(\d+)-', r['name'])
        return str(o['nr']) if 'nr' in o else m.group(1) if m else ''

    leads = {num_of(r): r for r in rows if num_of(r) in ('0', '1')}
    team = [r for r in rows if num_of(r) not in ('0', '1')]
    nt = {k: sum(1 for r in team if r['kind'] == k) for k in order}
    agents = sum(r['subs'] + r['wf_agents'] for r in team)
    print(f"{time.strftime('%H:%M')} · colleagues: free {nt['free']} · working {nt['working']} · waiting for you {nt['waiting']} · no report {nt['idle']} · background agents {agents}")
    print()
    print('Prompter (you)')
    print('  ↓ talk    ↑ answers, questions')
    print()
    print('| Who | Role | Ctx | State |')
    print('|---|---|---|---|')
    roles = {'0': ('Manager', 'talks to you, passes tasks on'), '1': ('Deputy', 'hands out tasks, release, housekeeping')}
    for num in ('0', '1'):
        r = leads.get(num)
        name, role = roles[num]
        if not r:
            state = '✖ no window' + (' · deputy stands in' if num == '0' else '')
            ctx = '–'
        else:
            state = {'waiting': f"⏳ waiting for you ({short(r['eta'], 22)})", 'working': '⚙ working'}.get(r['kind'], '◌ on watch')
            if r['kind'] == 'self':
                state = '● this session'
            ctx = f"{round(r['ctx'] / 10000)}%" if r['ctx'] else '–'
            if os.path.exists(f"{HOME}/.claude/tuned-clear/{r['sid']}"):
                state = '🧹 READY TO CLEAR'
            elif r['ctx'] >= 300000:
                state += ' · CONTEXT ALERT'
        print(f"| {name} | {role} | {ctx} | {state} |")
    print()
    print('  ↓ tasks    ↑ reports (tuned-report)')
    print()
    print('| # | Colleague | Ctx | State | ETA | Doing |')
    print('|---|---|---|---|---|---|')
    for r in team:
        o = r['order'] or {}
        bg = r['subs'] + r['wf_agents']
        state = label[r['kind']] + (f' +{bg}' if bg else '')
        eta = r['eta'].split(' (')[0] if r['kind'] == 'working' else r['eta'] if r['kind'] == 'waiting' else ''
        what = (o.get('what') or r['topic'].split(' (given')[0]) if r['kind'] in ('working', 'waiting', 'self') else '–'
        q = len(o.get('queue', []))
        if q:
            state += f' · {q} queued'
        # tuned-ready-to-clear: nothing open, only /clear left; ≥30% ctx: wants one, no new tasks; ≥35%: hands tasks off
        if os.path.exists(f"{HOME}/.claude/tuned-clear/{r['sid']}"):
            state = "🧹 READY TO CLEAR"
        elif r['ctx'] >= 350000:
            state += " · CONTEXT ALERT · HAND OFF"
        elif r['ctx'] >= 300000:
            state += " · CONTEXT ALERT"
        num = num_of(r)
        nr = f"#{shown_nr(r)}" if shown_nr(r) else ''
        name = o.get('label') or (re.match(r'^(\d+)-(.+)$', r['name']).group(2).replace('-', ' ') if num and re.match(r'^(\d+)-(.+)$', r['name']) else r['name'])
        ctx = f"{round(r['ctx'] / 10000)}%" if r['ctx'] else '–'
        print(f"| {nr} | {short(name, 16)} | {ctx} | {state} | {short(eta, 18) or ('?' if r['kind'] == 'working' else '')} | {short(what, 42)} |")

main()
