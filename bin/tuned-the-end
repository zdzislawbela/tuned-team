#!/bin/bash
# The manager runs this in the project to close the whole team.
#   tuned-the-end          check for unmerged work; if there is none, close the team
#   tuned-the-end --force  close the team even with unmerged work (only after the owner's yes)
#   tuned-the-end --show N the animation; the extension runs it in the manager's window
# Closing goes through the extension (vscode://tuned.tuned-team/end), like a restart.

if [ "$1" = "--show" ]; then
  secs=${2:-5}
  THE_END=(
    "████████ ██   ██ ███████     ███████ ███    ██ ██████ "
    "   ██    ██   ██ ██          ██      ████   ██ ██   ██"
    "   ██    ███████ █████       █████   ██ ██  ██ ██   ██"
    "   ██    ██   ██ ██          ██      ██  ██ ██ ██   ██"
    "   ██    ██   ██ ███████     ███████ ██   ████ ██████ "
  )
  GOOD_BYE=(
    " ██████   ██████   ██████  ██████      ██████  ██    ██ ███████"
    "██       ██    ██ ██    ██ ██   ██     ██   ██  ██  ██  ██     "
    "██   ███ ██    ██ ██    ██ ██   ██     ██████    ████   █████  "
    "██    ██ ██    ██ ██    ██ ██   ██     ██   ██    ██    ██     "
    " ██████   ██████   ██████  ██████      ██████     ██    ███████"
  )
  COLORS=(196 208 226 46 51 33 129 201)
  printf '\033[?25l'
  frames=$((secs * 5))
  for ((f = 0; f < frames; f++)); do
    printf '\033[2J\033[H\n\n'
    for ((i = 0; i < ${#THE_END[@]}; i++)); do
      printf '  \033[1;38;5;%sm%s\033[0m\n' "${COLORS[$(((f + i) % ${#COLORS[@]}))]}" "${THE_END[$i]}"
    done
    sleep 0.2
  done
  printf '\033[2J\033[H\n\n'
  for line in "${GOOD_BYE[@]}"; do printf '  \033[1;38;5;255m%s\033[0m\n' "$line"; done
  printf '\033[?25h'
  sleep 3
  exit 0
fi

top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Run it in the project's repository." >&2; exit 1; }
# The main checkout is the first entry of `git worktree list`.
main=$(git -C "$top" worktree list --porcelain | sed -n '1s/^worktree //p')
base=$(git -C "$main" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
[ -z "$base" ] && base=$(git -C "$main" branch --show-current)

open=()
# Branches not merged into the local base branch.
while read -r b; do
  [ -n "$b" ] && open+=("branch $b: not merged into $base")
done < <(git -C "$main" branch --format='%(refname:short)' --no-merged "$base")
# Worktrees besides the main checkout, and uncommitted changes in any of them
# (tracked files only in the main checkout: untracked scratch files there do not count).
while read -r wt; do
  if [ "$wt" = "$main" ]; then
    changes=$(git -C "$wt" status --porcelain --untracked-files=no)
  else
    open+=("worktree $wt")
    changes=$(git -C "$wt" status --porcelain)
  fi
  [ -n "$changes" ] && open+=("uncommitted files in $wt: $(echo "$changes" | wc -l | tr -d ' ')")
done < <(git -C "$main" worktree list --porcelain | sed -n 's/^worktree //p')

if [ ${#open[@]} -gt 0 ] && [ "$1" != "--force" ]; then
  echo "Unmerged work, the team stays open:"
  printf '  - %s\n' "${open[@]}"
  echo "Close anyway? Only after the owner's yes: tuned-the-end --force"
  exit 1
fi

open "vscode://tuned.tuned-team/end"
echo "THE END: the team is closing."
